{
  "type": "module",
  "name": "@rvoh/create-psychic",
  "version": "3.7.8",
  "description": "creates a new psychic app",
  "author": "RVO Health",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/create-psychic.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "bin": "./dist/esm/src/bin.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "echo \"building cjs...\" && rm -rf dist && pnpm tsc -p ./tsconfig.cjs.build.json && cp -R boilerplate ./dist/cjs && echo \"building esm...\" && pnpm tsc -p ./tsconfig.esm.build.json && cp -R boilerplate ./dist/esm",
    "psy": "tsx ./src/psy.ts",
    "prepack": "pnpm build",
    "spec": "CREATE_PSYCHIC_CORE_TEST=1 vitest --config=./spec/unit/vite.config.ts",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" \"spec/**/*.ts\" && pnpm prettier . --check",
    "format": "pnpm prettier . --write"
  },
  "dependencies": {
    "@rvoh/dream": "^2.30.1",
    "@types/node": "^22.6.1",
    "commander": "^14.0.3",
    "pino-std-serializers": "^4.0.0",
    "typescript": "^5.9.3",
    "yoctocolors": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rvoh/dream-spec-helpers": "^2.3.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "kysely": "^0.29.5",
    "kysely-codegen": "~0.20.0",
    "luxon-jest-matchers": "^0.1.14",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "puppeteer": "~25.10.0",
    "supertest": "^7.2.2",
    "tslib": "^2.7.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
